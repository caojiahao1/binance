# 复制成 .env 后填入真实值（.env 已被 .gitignore 排除）
# 币安 API：https://www.binance.com/zh-CN/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ngrok 公网地址：https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_URL=

# PushPlus 推送 token（可选）：https://www.pushplus.plus/
PUSHPLUS_TOKEN=

# FMZ 机器人账号（仅 money 用）
FMZ_ACCESS_KEY=
FMZ_SECRET_KEY=
FMZ_ROBOT_ID=
